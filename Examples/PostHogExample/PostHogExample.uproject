{
	"FileVersion": 3,
	"EngineAssociation": "5.8",
	"Category": "Analytics",
	"Description": "Playable three-lane runner demonstrating PostHog analytics and feature flags",
	"Modules": [
		{
			"Name": "PostHogExample",
			"Type": "Runtime",
			"LoadingPhase": "Default"
		}
	],
	"Plugins": [
		{ "Name": "AnalyticsBlueprintLibrary", "Enabled": true },
		{ "Name": "AnalyticsMulticast", "Enabled": true },
		{
			"Name": "PostHog",
			"Enabled": true,
			"SupportedTargetPlatforms": [
				"Mac"
			]
		}
	]
}